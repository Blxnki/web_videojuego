---
import '../styles/global.css';
interface Props { title?: string; description?: string; }
const { title = 'Midnight of Vein — La noche no termina entre rejas', description = 'Un vampiro, una deuda y una prisión llena de experimentos. Descubre Midnight of Vein: combate, plataformas y puzles. Disponible para Windows y Android.' } = Astro.props;
const preview = new URL('/media/midnight-of-vein.webp', Astro.url.origin).href;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b090e" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={preview} />
    <meta property="og:image:alt" content="Logo gótico cromado de Midnight of Vein" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/Barlow-Regular.ttf" as="font" type="font/ttf" crossorigin />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Saltar al contenido</a>
    <slot />
    <script>import '../scripts/experience';</script>
  </body>
</html>
