---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
const captures = [
  { image: 'lasers', title: 'No toques el rojo.', label: '01 / PLATAFORMAS', alt: 'Vein atraviesa plataformas y barreras láser rojas dentro de la prisión' },
  { image: 'combat', title: 'Aquí nadie sale ileso.', label: '02 / COMBATE', alt: 'Combate contra enemigos deformados en una celda con manchas de sangre' },
  { image: 'puzzles', title: 'La fuerza no lo abre todo.', label: '03 / PUZLES', alt: 'Sala de puzles de la prisión, con cajas y mecanismos para abrir una salida' },
  { image: 'prison', title: 'La salida está ahí fuera.', label: '04 / LA PRISIÓN', alt: 'Plataformas suspendidas ante las celdas y ventanas del laboratorio' },
];
---
<Layout>
  <Header />
  <main id="main">
    <section class="hero" data-hero aria-labelledby="game-title">
      <img class="hero-environment" src="/media/prison-laboratory.webp" alt="" width="1920" height="1080" fetchpriority="high" />
      <div class="hero-grid" aria-hidden="true"></div>
      <div class="hero-topline wrap"><span><i class="status-light"></i> UNA TRANSMISIÓN DESDE VOLVANIA</span><span>INDEPENDIENTE · HECHO EN GODOT</span></div>
      <div class="hero-content wrap">
        <div class="hero-copy">
          <p class="eyebrow" data-hero-reveal><span>✦</span> BIENVENIDO AL LADO OSCURO</p>
          <h1 id="game-title" data-hero-reveal><span class="sr-only">Midnight of Vein</span><img class="hero-logo" src="/media/midnight-of-vein.webp" width="1050" height="700" alt="" fetchpriority="high" /></h1>
          <p class="hero-tagline" data-hero-reveal>La noche no termina<br />entre <em>rejas.</em></p>
          <p class="hero-description" data-hero-reveal>Eres un vampiro. Debes dinero. Y esta prisión<br class="desktop-break" /> tiene planes mucho peores para ti.</p>
          <div class="hero-actions" data-hero-reveal><a class="button button-primary" href="/descargar" data-magnetic>Descargar el juego <Icon name="download" /></a><a class="text-link" href="#capturas">Explorar el juego <Icon name="arrow" /></a></div>
          <p class="platform-line" data-hero-reveal><Icon name="windows" /> Windows <span>+</span> <Icon name="android" /> Android <span class="platform-divider">/</span> DESCARGA DIRECTA</p>
        </div>
        <div class="hero-visual" data-parallax="10">
          <span class="orbit-star star-one" aria-hidden="true">✧</span><span class="orbit-star star-two" aria-hidden="true">✦</span>
          <div class="monitor" data-hero-reveal>
            <div class="monitor-bar"><span><i class="status-light red"></i> PRISIÓN / CÁMARA 02</span><span class="monitor-buttons" aria-hidden="true">— □ ×</span></div>
            <div class="monitor-screen"><img src="/media/lasers-1280.webp" srcset="/media/lasers-640.webp 640w, /media/lasers-1280.webp 1280w" sizes="(max-width: 899px) 90vw, 48vw" width="1280" height="720" alt="Una sala de Midnight of Vein: plataformas, barrotes y rayos láser rojos" fetchpriority="high" /><span class="screen-corner tl" aria-hidden="true"></span><span class="screen-corner br" aria-hidden="true"></span></div>
            <div class="monitor-footer"><span>CAPTURA EN DESARROLLO</span><span>SEÑAL RECUPERADA <i class="signal-bars" aria-hidden="true">▂▄▆█</i></span></div>
          </div>
          <div class="evidence-tag" data-hero-reveal><span class="barcode" aria-hidden="true"></span><div>SUJETO: VEIN<br /><strong>ESTADO: NO COOPERATIVO</strong></div><Icon name="star" /></div>
        </div>
      </div>
      <div class="hero-bottom wrap"><span>01 — EL DESCENSO</span><a href="#historia">SIGUE LA SEÑAL <span aria-hidden="true">↓</span></a><span>NO HAY VISITAS. NO HAY GARANTÍAS.</span></div>
    </section>
    <div class="ticker"><span class="sr-only">Combate, plataformas, puzles. Una sola salida.</span><div class="ticker-track" aria-hidden="true">{[0, 1, 2, 3].map(() => <span>COMBATE <i>✦</i> PLATAFORMAS <i>✦</i> PUZLES <i>✦</i> UNA SOLA SALIDA <i>✦</i></span>)}</div></div>
    <section id="historia" class="story section wrap" aria-labelledby="story-title">
      <div class="story-art" data-reveal><div class="file-header"><span>ARCHIVO RECUPERADO</span><span>V—001</span></div><div class="story-image"><img src="/media/prison-laboratory.webp" alt="Pasillos oscuros, barrotes y laboratorios de la prisión" width="1920" height="1080" loading="lazy" /><div class="prison-stamp">SIN<br />SALIDA<span>VOLVANIA CITY</span></div></div><div class="file-footer"><span>✦ SUJETO INMORTAL</span><span class="stamp">CLASIFICADO</span></div></div>
      <div class="story-copy" data-reveal><p class="eyebrow"><span>02</span> EL EXPEDIENTE</p><h2 id="story-title">Una mala apuesta.<br />Una <em>larga noche.</em></h2><p>Siglos esquivando el sol para acabar perdiéndolo todo en una mesa de juego. Vein le debe una fortuna al capo más peligroso de Volvania City. Y la mafia no acepta un «te lo pago la semana que viene».</p><p>Un golpe. Un saco. Una celda que huele a lejía y miedo. Tras los barrotes hay experimentos, criaturas deformadas y un sistema de seguridad que dispara primero.</p><p class="story-punchline">Tienes toda la eternidad.<br /><strong>Pero esta noche tienes que escapar.</strong></p></div>
    </section>
    <section id="jugabilidad" class="gameplay section" aria-labelledby="gameplay-title">
      <div class="section-heading wrap" data-reveal><div><p class="eyebrow"><span>03</span> INSTINTO DE SUPERVIVENCIA</p><h2 id="gameplay-title">No basta con<br />ser <em>inmortal.</em></h2></div><p>Cambia de ritmo. Lee la sala.<br />Haz lo que sea para salir de ella.</p><Icon class="section-star" name="star" /></div>
      <div class="gameplay-list wrap">
        <article class="gameplay-row" data-reveal><div class="mechanic-number">01<span>COMBATE</span></div><div class="mechanic-copy"><h3>Colmillos fuera.</h3><p>Los otros prisioneros ya no son lo que eran. Enfréntate a los resultados de los experimentos y encuentra un hueco para seguir vivo.</p><span class="mechanic-tag">ENEMIGOS DEFORMADOS · COMBATE DIRECTO</span></div><a href="#capturas" class="mechanic-image" aria-label="Ver las capturas del combate"><img src="/media/combat-640.webp" width="640" height="360" alt="" loading="lazy" /><span><Icon name="arrow" /></span></a></article>
        <article class="gameplay-row" data-reveal><div class="mechanic-number">02<span>PLATAFORMAS</span></div><div class="mechanic-copy"><h3>Un paso en falso.</h3><p>Salta entre plataformas y atraviesa pasillos protegidos por láseres. El rojo nunca ha sido tan mala señal.</p><span class="mechanic-tag">PRECISIÓN · LÁSERES · REFLEJOS</span></div><a href="#capturas" class="mechanic-image" aria-label="Ver las capturas de plataformas"><img src="/media/lasers-640.webp" width="640" height="360" alt="" loading="lazy" /><span><Icon name="arrow" /></span></a></article>
        <article class="gameplay-row" data-reveal><div class="mechanic-number">03<span>PUZLES</span></div><div class="mechanic-copy"><h3>Piensa como un fugado.</h3><p>Mueve cajas, interpreta cada habitación y activa los mecanismos. Algunas puertas necesitan algo más que fuerza bruta.</p><span class="mechanic-tag">OBSERVACIÓN · CAJAS · MECANISMOS</span></div><a href="#capturas" class="mechanic-image" aria-label="Ver las capturas de puzles"><img src="/media/puzzles-640.webp" width="640" height="360" alt="" loading="lazy" /><span><Icon name="arrow" /></span></a></article>
      </div>
    </section>
    <section id="capturas" class="gallery section wrap" aria-labelledby="gallery-title">
      <div class="section-heading" data-reveal><div><p class="eyebrow"><span>04</span> EVIDENCIAS DEL ENCIERRO</p><h2 id="gallery-title">Dentro de<br /><em>la prisión.</em></h2></div><p>Capturas reales de la versión en desarrollo.<br />Ábrelas. Mira de cerca.</p></div>
      <div class="gallery-grid">{captures.map((capture) => <a class="gallery-item" href={`/media/${capture.image}-1280.webp`} data-gallery data-caption={`${capture.title} ${capture.alt}.`} data-reveal><div class="gallery-image"><img src={`/media/${capture.image}-640.webp`} srcset={`/media/${capture.image}-640.webp 640w, /media/${capture.image}-1280.webp 1280w`} sizes="(max-width: 600px) 92vw, 46vw" alt={capture.alt} width="1280" height="720" loading="lazy" /><span class="image-expand" aria-hidden="true"><Icon name="arrow" /></span></div><div class="gallery-caption"><h3>{capture.title}</h3><span>{capture.label}</span></div></a>)}</div>
    </section>
    <section class="escape-section" aria-labelledby="escape-title"><div class="escape-orbit" aria-hidden="true"></div><div class="escape-content wrap" data-reveal><p class="eyebrow">TU PRÓXIMA MALA DECISIÓN EMPIEZA AQUÍ</p><h2 id="escape-title">Rompe<br /><em>el encierro.</em></h2><p>La deuda puede esperar. Tu fuga, no.</p><a class="button button-primary" href="/descargar" data-magnetic>Descargar Midnight of Vein <Icon name="download" /></a><span class="escape-platforms">WINDOWS + ANDROID</span></div><span class="escape-star" aria-hidden="true">✦</span></section>
  </main>
  <Footer />
  <dialog id="gallery-dialog" aria-label="Galería de Midnight of Vein" aria-describedby="gallery-caption"><div class="dialog-toolbar"><span>ARCHIVO VISUAL / MIDNIGHT OF VEIN</span><button class="icon-button" data-gallery-close aria-label="Cerrar galería"><Icon name="close" /></button></div><img id="gallery-image" width="1280" height="720" alt="" /><div class="dialog-bottom"><p id="gallery-caption"></p><div class="gallery-controls"><button id="gallery-prev" class="icon-button" aria-label="Captura anterior">←</button><span id="gallery-counter" aria-live="polite"></span><button id="gallery-next" class="icon-button" aria-label="Captura siguiente">→</button></div></div></dialog>
</Layout>
